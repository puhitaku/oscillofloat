# Copy to deploy.env (git-ignored) and fill in. Read by scripts/lib.sh.

# AWS CLI profile to use. Leave empty for the default credential chain.
AWS_PROFILE=

# Main region: the stack, the instance, the user pool and the database bucket.
AWS_REGION=ap-northeast-1

# Domain the site is served on. It is also the passkey relying party ID, so
# changing it later invalidates every registered passkey.
DOMAIN_NAME=oscillofloat.example.com

# Route 53 hosted zone that holds DOMAIN_NAME (the zone of the domain or of a
# parent domain). The certificate validation record and the alias records go there.
HOSTED_ZONE_ID=Z0000000000EXAMPLE

# Globally unique name of the bucket that holds the Litestream replica of the
# database. Created by scripts/create-db-bucket.sh and kept out of the stack,
# so deleting the stack never deletes the data.
DATABASE_BUCKET=oscillofloat-db-example

# Name of the main stack in AWS_REGION.
STACK_NAME=oscillofloat

# Name of the certificate stack in us-east-1.
CERT_STACK_NAME=oscillofloat-cert

# An arm64 (Graviton) instance type.
INSTANCE_TYPE=t4g.nano

# Optional: uploads allowed per client address per minute (backend default 10).
#UPLOAD_RATE=10

# Optional: Litestream 0.3.x release to install (template default 0.3.14).
#LITESTREAM_VERSION=0.3.14
